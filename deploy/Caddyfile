# Public API at api.memepred.xyz — change to your domain.
{$API_DOMAIN:api.memepred.xyz} {
    encode gzip zstd

    # Worker bypass — keep header forwarding so /api/geo can read X-Country.
    # The frontend never hits this directly in prod; the Cloudflare Worker proxies.
    reverse_proxy backend:3001 {
        header_up X-Real-IP {remote_host}
        header_up X-Forwarded-For {remote_host}
    }

    log {
        output stdout
        format json
    }
}
