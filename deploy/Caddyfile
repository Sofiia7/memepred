{
    # Email used by Let's Encrypt for cert notifications.
    email {$LETSENCRYPT_EMAIL}
}

# Public API at api.flipthememe.com — change to your domain.
{$API_DOMAIN:api.flipthememe.com} {
    encode gzip zstd

    # Security headers — applied to every response.
    header {
        Strict-Transport-Security    "max-age=31536000; includeSubDomains; preload"
        X-Content-Type-Options       "nosniff"
        X-Frame-Options              "DENY"
        Referrer-Policy              "strict-origin-when-cross-origin"
        Permissions-Policy           "interest-cohort=()"
        Content-Security-Policy      "default-src 'none'; frame-ancestors 'none'"
        Cross-Origin-Resource-Policy "same-site"
        -Server
    }

    # Worker bypass — keep header forwarding so /api/geo can read X-Country.
    # The frontend never hits this directly in prod; the Cloudflare Worker proxies.
    reverse_proxy backend:3001 {
        header_up X-Real-IP {remote_host}
        header_up X-Forwarded-For {remote_host}
    }

    # Caddy's json access log records every request header. It redacts Cookie
    # and Authorization on its own, but X-Worker-Secret is ours, so the
    # geo-block Worker's shared secret was being written to disk in cleartext
    # on every single request. Drop it from the log rather than turning the
    # access log off — the log itself is useful.
    log {
        output stdout
        format filter {
            wrap json
            request>headers>X-Worker-Secret delete
        }
    }
}
