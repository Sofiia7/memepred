# Environment for a Robinhood Chain TESTNET build of the frontend (chain id 46630).
#
# Copy to .env.rhc-testnet and build with `vite build --mode rhc-testnet`, or set
# the same names in the Vercel project for rhc.flipthememe.com. Every line
# below is needed unless it says optional.
#
# Names only, and no secrets: a VITE_ variable is compiled into the public
# bundle and readable by anyone who opens the site.
#
# The placeholders (0x...) fail validation on purpose. Left unfilled, the site
# shows its "Frontend is not configured" screen instead of sending wallet calls
# to a zero address.

# Which network this build is for. Strict: mainnet | sepolia | rhc | rhc-testnet.
# Anything else (a typo, a leftover Base value) is refused with the config
# screen and never defaults to a chain.
VITE_NETWORK=rhc-testnet

# Robinhood Chain testnet RPC. Robinhood builds read this one; VITE_BASE_RPC_URL
# is a Base setting and is not needed here.
VITE_RHC_RPC_URL=https://rpc.testnet.chain.robinhood.com

# Public API of the backend (behind the Cloudflare geo-block Worker), no
# trailing slash. The site also asks it GET /api/deployment on load and refuses
# to sign if its factory or chain id differ from the ones below.
VITE_API_URL=https://api-rhc.flipthememe.com

# Public origin of this site, no trailing slash. Read at BUILD time for og:url and
# the preview image; without it those tags are left out of index.html.
VITE_SITE_URL=https://rhc.flipthememe.com

# Faucet link shown to a wallet holding no test ETH. Optional: this is the
# default when the line is absent.
VITE_FAUCET_URL=https://ethfaucet.com/networks/robinhood/robinhood-testnet

# The deployment this site talks to. Take every address from the same
# deployment as the backend's .env.rhc (backend key in brackets), never from an
# older one: a factory that differs from the one the API indexes disables signing.
#
# PoolMarketFactory  [MARKET_FACTORY]
VITE_MARKET_FACTORY=0x...
# PoolOracleResolver  [ORACLE_RESOLVER]
VITE_ORACLE_RESOLVER=0x...
# PoolLiquidityPool, the LP vault  [LIQUIDITY_POOL]
VITE_LIQUIDITY_POOL=0x...
# The stake token, WETH on this chain. The name is historical (it was USDC on
# Base); this is the address the site approves and bets with.  [USDC_ADDRESS]
VITE_USDC_ADDRESS=0x...
# RhcFeeDistributor  [FEE_DISTRIBUTOR]
VITE_FEE_DISTRIBUTOR=0x...
# ReferralRegistry  [REFERRAL_REGISTRY]
VITE_REFERRAL_REGISTRY=0x...
# BadgeNFT  [BADGE_NFT]
VITE_BADGE_NFT=0x...
# GenesisNFT  [GENESIS_NFT]
VITE_GENESIS_NFT=0x...

# 0 keeps the region check on, which is what a deployed site needs. Say it
# explicitly: Vite reads .env.local first in every mode, and the Base site's
# local file sets this to 1, which would otherwise be carried into a build made
# on that machine. 1 skips the check (local development and previews with no
# Worker in front of the API only).
VITE_DISABLE_GEOBLOCK=0

# Countries this deployment has opened, comma-separated ISO codes. The frontend half
# of GEO_OPEN_COUNTRIES in workers/wrangler.geo-block.rhc.toml: keep them identical,
# or the page copy and the edge disagree. Only GB, FR, DE, NL, CA, AU, JP and SG
# can be opened (never OFAC countries, the US or Tor). Empty keeps the full
# restricted list. Singapore is open here because this is the testnet demo for the
# Arbitrum Open House Singapore buildathon (Sofia, 2026-09-29).
VITE_GEO_OPEN_COUNTRIES=SG

# 2026-10-01, Sofia's decision for the buildathon demo: the whole restricted list
# is switched off on this deployment, so judges anywhere (the U.S. included) can
# open the site. Exactly 1. The frontend half of GEO_OPEN_ALL_RESTRICTED in
# workers/wrangler.geo-block.rhc.toml: keep both in step, or the page copy and the
# edge disagree. The four OFAC countries stay blocked. Never set this on a build
# that handles real funds.
VITE_GEO_OPEN_ALL_RESTRICTED=1

# Optional. Where the Terms tell people to report a vulnerability.
# VITE_SECURITY_CONTACT=security@example.com

# Optional. The rounds screen (/rounds, PoolRounds v2 candidate). Off unless exactly 1:
# with it off the build has no route, no tab and none of its code. docs/rhc/ROUNDS-UI.md.
# VITE_ROUNDS_ENABLED=1
# Only for a PoolRounds deployment with betWithEth/claimAsEth and a redeemable,
# fully backed WETH. Never enable against the original MockWETH deployment.
# VITE_ROUNDS_NATIVE_ETH=1
# VITE_POOL_ROUNDS_ADDRESS=0x...
# VITE_ROUNDS_DEPLOY_BLOCK=0
# VITE_ROUNDS_DURATIONS=300,900
