# =============================================================
# FlipTheMeme — example env. Copy to .env and fill in real values.
# NEVER commit .env. See .gitignore.
# =============================================================

# ── NETWORK ─────────────────────────────────────────────────
# mainnet | sepolia
NETWORK=sepolia
BASE_RPC_URL=https://sepolia.base.org
BASESCAN_API_KEY=

# ── EXTERNAL TOKEN / ORACLE ─────────────────────────────────
# Base mainnet USDC = 0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913
# Base sepolia USDC = 0x036CbD53842c5426634e7929541eC2318f3dCF7e
USDC_ADDRESS=0x036CbD53842c5426634e7929541eC2318f3dCF7e
# Pyth on Base = 0x8250f4aF4B972684F7b336503E2D6dFeDeB1487a (same on sepolia)
PYTH_ADDRESS=0x8250f4aF4B972684F7b336503E2D6dFeDeB1487a

# ── DEPLOYED CONTRACT ADDRESSES ─────────────────────────────
MARKET_FACTORY=0x...
ORACLE_RESOLVER=0x...
FEE_DISTRIBUTOR=0x...
REFERRAL_REGISTRY=0x...
BADGE_NFT=0x...
LIQUIDITY_POOL=0x...
GENESIS_NFT=0x...

# ── KEYS / ROLES ────────────────────────────────────────────
# Deployer (one-shot; transfers ownership to multisig after deploy)
PRIVATE_KEY=0x...
# Gnosis Safe 3/5 — owner of every contract after Sprint 2
MULTISIG_ADDRESS=0x...
TREASURY_ADDRESS=0x...
# Keeper hot wallet: address (for grantRole) and private key (for backend)
KEEPER_ADDRESS=0x...
KEEPER_PRIVATE_KEY=0x...
# Backend BadgeNFT minter
BADGE_MINTER_KEY=0x...

# ── BACKEND (Fastify) ───────────────────────────────────────
DATABASE_URL=postgres://memepred:memepred@localhost:5432/memepred
REDIS_URL=redis://localhost:6379
PORT=3001
# Shared secret between Cloudflare Worker and backend /api/geo.
# Rotate quarterly; never log.
WORKER_SECRET=change-me-32-bytes-of-random
# CORS allowlist, comma-separated. Localhost is fine in dev.
VITE_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ── FRONTEND (Vite, exposed to browser — never put secrets here) ──
VITE_NETWORK=sepolia
VITE_BASE_RPC_URL=https://sepolia.base.org
VITE_USDC_ADDRESS=0x036CbD53842c5426634e7929541eC2318f3dCF7e
VITE_MARKET_FACTORY=0x...
VITE_ORACLE_RESOLVER=0x...
VITE_FEE_DISTRIBUTOR=0x...
VITE_REFERRAL_REGISTRY=0x...
VITE_BADGE_NFT=0x...
VITE_LIQUIDITY_POOL=0x...
VITE_GENESIS_NFT=0x...
VITE_API_URL=http://localhost:3001
VITE_GRAPH_URL=https://api.studio.thegraph.com/query/.../memepred-sepolia/version/latest
# Pyth: the browser no longer calls Hermes directly. It fetches priceUpdateData
# from the backend at /api/pyth/updates, which holds the credential. VITE_PYTH_HERMES
# is therefore gone - see PYTH_API_KEY below.
# Per-market feedId is still read on-chain via market.pythFeedId() (Sprint 4 fix).

# ── PYTH (server-side only) ─────────────────────────────────
PYTH_HERMES_URL=https://hermes.pyth.network
# Bearer token for Hermes. Register at Pyth Terminal to get one.
# Required since the Pyth Core upgrade closed unauthenticated access on
# 2026-08-26 16:00 UTC - without it every price push, settlement, feed ping and
# bet returns 401. Never expose this as a VITE_* variable: Vite inlines those
# into the public browser bundle, which is exactly why the proxy route exists.
PYTH_API_KEY=

# ── EXTERNAL APIS ───────────────────────────────────────────
PINATA_API_KEY=
DISCORD_BOT_TOKEN=
TWITTER_BEARER_TOKEN=
