# =============================================================
# FlipTheMeme - example env. Copy to .env and fill in real values.
# NEVER commit .env. See .gitignore.
# =============================================================

# ── NETWORK ─────────────────────────────────────────────────
# The switch that decides which chain the keeper signs for. Read by twelve
# backend files, all of which treat anything other than 8453 as Base Sepolia,
# and docker-compose defaults it to 84532 - so a mainnet deployment built from
# this template without setting it signs testnet-chain-id transactions and
# every one of them is invalid.
#   8453  = Base mainnet
#   84532 = Base Sepolia
CHAIN_ID=84532
BASE_RPC_URL=https://sepolia.base.org
BASESCAN_API_KEY=

# ── EXTERNAL TOKEN / ORACLE ─────────────────────────────────
# Base mainnet USDC = 0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913
# Base sepolia USDC = 0x036CbD53842c5426634e7929541eC2318f3dCF7e
USDC_ADDRESS=0x036CbD53842c5426634e7929541eC2318f3dCF7e

# ── DEPLOYED CONTRACT ADDRESSES ─────────────────────────────
MARKET_FACTORY=0x...
ORACLE_RESOLVER=0x...
FEE_DISTRIBUTOR=0x...
REFERRAL_REGISTRY=0x...
BADGE_NFT=0x...
LIQUIDITY_POOL=0x...
GENESIS_NFT=0x...

# ── KEYS / ROLES ────────────────────────────────────────────
# Deployer (one-shot; transfers ownership to multisig after deploy)
PRIVATE_KEY=0x...
# Gnosis Safe 3/5 - owner of every contract after Sprint 2
MULTISIG_ADDRESS=0x...
TREASURY_ADDRESS=0x...
# Keeper hot wallet: address (for grantRole) and private key (for backend)
KEEPER_ADDRESS=0x...
KEEPER_PRIVATE_KEY=0x...
# Backend BadgeNFT minter
BADGE_MINTER_KEY=0x...

# ── BACKEND (Fastify) ───────────────────────────────────────
DATABASE_URL=postgres://memepred:memepred@localhost:5432/memepred
REDIS_URL=redis://localhost:6379
PORT=3001
# Shared secret between Cloudflare Worker and backend /api/geo.
# Rotate quarterly; never log.
WORKER_SECRET=change-me-32-bytes-of-random
# CORS allowlist, comma-separated. Localhost is fine in dev.
# Named without the VITE_ prefix on purpose: this is read by the Fastify
# server, and a VITE_ prefix would inline it into the browser bundle instead.
# Documented under the wrong name until now, so the knob did nothing and CORS
# silently fell back to its built-in list.
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ── FRONTEND (Vite, exposed to browser - never put secrets here) ──
VITE_NETWORK=sepolia
VITE_BASE_RPC_URL=https://sepolia.base.org
VITE_USDC_ADDRESS=0x036CbD53842c5426634e7929541eC2318f3dCF7e
VITE_MARKET_FACTORY=0x...
VITE_ORACLE_RESOLVER=0x...
VITE_FEE_DISTRIBUTOR=0x...
VITE_REFERRAL_REGISTRY=0x...
VITE_BADGE_NFT=0x...
VITE_LIQUIDITY_POOL=0x...
VITE_GENESIS_NFT=0x...
VITE_API_URL=http://localhost:3001
# Oracle: the browser reads prices and bet payloads from our own API at
# /api/oracle/*. No credential is involved - RedStone's gateway is public - but
# building a payload in the browser would mean bundling
# @redstone-finance/protocol and its ethers v5 dependency into a viem app.
# Per-market feedId is still read on-chain via market.pythFeedId().

# ── ORACLE (RedStone) ───────────────────────────────────────
# No API key. RedStone's gateway is public, which is the whole reason the
# oracle moved here: Pyth's Core upgrade put every memecoin feed behind a
# $500/month plan on 2026-08-26. Override only to point at a mirror.
REDSTONE_GATEWAY_URL=https://oracle-gateway-1.a.redstone.finance
REDSTONE_DATA_SERVICE=redstone-primary-prod

# ── DEPLOY (docker-compose) ─────────────────────────────────
# Required by deploy/docker-compose.yml and absent from this file until now:
# compose substitutes an empty string for anything unset, so a stack seeded
# from this template came up with a passwordless Postgres and Redis.
POSTGRES_USER=memepred
POSTGRES_PASSWORD=change-me
POSTGRES_DB=memepred
REDIS_PASSWORD=change-me
# Caddy: the hostname it gets a certificate for, and the ACME contact.
API_DOMAIN=api.flipthememe.com
LETSENCRYPT_EMAIL=
# Block the indexer starts from. Use the factory's deploy block; starting at 0
# makes the first sync walk the whole chain.
INDEXER_START_BLOCK=0

# ── ROBINHOOD CHAIN (CHAIN_PROFILE=rhc) ─────────────────────
# A deployment on Robinhood Chain reads its own env file (.env.rhc); these are the
# knobs that are easy to forget and silent when wrong.
#
# CHAIN_PROFILE=rhc                 base (the default) or rhc. Anything else throws.
# MARKET_FACTORY=0x...              on rhc this ALSO decides which markets are served:
#                                   only rows the indexer stamped with this factory
#                                   (markets.factory_address) are listed or acted on.
#                                   Rows indexed before migration 008 hold NULL and
#                                   count as an earlier factory's - stamp a current
#                                   market by hand if one predates it:
#                                   UPDATE markets SET factory_address = LOWER('0x<factory>')
#                                    WHERE market_address = LOWER('0x<market>');
#
# CORS allowlist for the API. The built-in default is the Base site only, so an
# RHC frontend on its own host gets every product response blocked by the browser
# (the edge worker answers only the preflight) and every page says it could not
# load markets. Set it to the RHC site, comma-separated, and restart the API.
# ALLOWED_ORIGINS=https://rhc.flipthememe.com
#
# Seconds a DUE match may wait for the keeper before /health/deep warns
# ("ready-match-lag"). A pool that trades every second keeps only about 300
# seconds of price history, so a match unresolved for roughly 120-240 seconds
# risks a refund instead of a settlement. Default 90 on rhc, off on Base; 0 turns
# it off.
# READY_MATCH_WARN_SEC=90
#
# Commit the running build came from, reported by GET /api/deployment so the
# frontend can check it is talking to the deployment it was built for. Set it at
# image build time (docker build --build-arg GIT_COMMIT=$(git rev-parse HEAD));
# unset reads null.
# GIT_COMMIT=
#
# Per-tick budget of settlement-queue windows that are only READ (nothing due in
# them). Raise it only if a stuck match sits behind more than 1000 settled ones.
# RESOLVE_MAX_EMPTY_WINDOWS=40

# ── EXTERNAL APIS ───────────────────────────────────────────
PINATA_API_KEY=
DISCORD_BOT_TOKEN=
TWITTER_BEARER_TOKEN=
