# Secrets & Credentials
.env
.env.*
!.env.example
*.key
*.pem
*.json
!package.json
!tsconfig.json
!openclaw.json
!pnpm-lock.yaml
!.github/**/*.json
!frontend/**/*.json
!backend/**/*.json
!contracts/**/*.json
!assets/**/*.json
# The re-includes above exist for legitimate committed config json
# (tsconfig.json, package.json, vercel.json, etc.) living under these
# directories - they are not meant to un-ignore a stray env file that
# happens to end in .json. Re-ignore those specifically, after the
# negations above so this wins: without this, backend/.env.json (or the
# same under frontend/contracts/assets/.github) would NOT be gitignored,
# because *.json is ignored at the top of this file but the per-directory
# negation above re-includes anything under these dirs matching *.json,
# .env.json included.
.github/**/.env*
frontend/**/.env*
backend/**/.env*
contracts/**/.env*
assets/**/.env*
secrets.json

# Foundry / build artifacts inside contracts that we still want ignored
contracts/out/**/*.json
contracts/cache/**/*.json
contracts/broadcast/**/*.json
contracts/lcov.info

# Python
__pycache__/
*.py[cod]
venv/
.venv/
.pytest_cache/
.agent/

# Downloaded font cache (scripts/generate-genesis-nft-art.py)
.cache/

# Generated NFT art working files (~37MB) — already pinned on IPFS/Pinata,
# CIDs are in contracts/script/Deploy.s.sol. Not worth bloating the repo.
nft-art/

# JS/Node
node_modules/
dist/
build/
.next/
.vscode/

# Logs
*.log
logs/

# Foundry dependency
contracts/lib/openzeppelin-contracts/
contracts/out/
contracts/cache/
.testwallets/

# docker-compose's db-backup service writes .sql.gz dumps here - real user
# data, must never be committed.
deploy/backups/

# Local wrangler secrets (read by `wrangler dev`); never commit.
workers/.dev.vars

# Claude session state
.claude/

# npm lockfiles (project uses pnpm)
package-lock.json
**/package-lock.json

# forge-std generated test fixtures
contracts/lib/forge-std/test/fixtures/

# wrangler build temp
workers/.wrangler/

# Замеры §7 для Robinhood Chain: сырые данные - доказательство под числами
# в docs/rhc/measurements/README.md, без них цифры нечем перепроверить.
!docs/rhc/measurements/*.json

# Raw measurements behind docs/rhc/ECONOMICS.md (logs and json): the point of keeping them is that anyone can re-check the estimates
!docs/rhc/measurements/economics/*.json
!docs/rhc/measurements/economics/*.log
